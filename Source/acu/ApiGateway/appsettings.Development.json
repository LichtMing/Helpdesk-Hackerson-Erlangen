{
  "DataPath": "bin/Debug/net10.0/devices.json",
  "WorkflowDataPath": "bin/Debug/net10.0/workflows.json",
  "RobotWorkflowDataPath": "D:/data/robot-workflows.json",
  "RobotMediaDataPath": "bin/Debug/net10.0/robot-media",
  "AcuSettingsDataPath": "bin/Debug/net10.0/acu-settings.json",
  "Conversation": {
    "EnableDevelopmentResponses": true,
    "SessionIdleTimeoutMinutes": 5,
    "MaxTurns": 6
  },
  "Helpdesk": {
    "Enabled": false,
    "BaseUrl": "http://localhost:8000",
    "TimeoutSeconds": 150
  },
  "Tts": {
    "Enabled": true,
    "Provider": "Piper",
    "PiperExecutable": "python3",
    "PiperScript": "/app/piper_synthesize.py",
    "ModelDirectory": "/models",
    "EnglishVoice": "en_US-lessac-medium",
    "GermanVoice": "de_DE-thorsten-medium",
    "ChineseVoice": "zh_CN-huayan-medium",
    "LengthScale": 1.0,
    "SentenceSilenceSeconds": 0.15,
    "TimeoutSeconds": 60,
    "Executable": "espeak-ng",
    "WordsPerMinute": 155
  },
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://0.0.0.0:3000" }
    }
  }
}
