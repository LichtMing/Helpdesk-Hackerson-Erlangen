{
  "name": "robot_pwa_app",
  "private": true,
  "version": "0.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android",
    "models:prepare": "node scripts/prepare-speech-models.mjs",
    "models:check": "node scripts/prepare-speech-models.mjs --check",
    "build:apk": "node scripts/build-apk.mjs",
    "typecheck": "tsc --noEmit",
    "test:config": "node --experimental-strip-types --test tests/robotConfig.test.mjs",
    "test:device": "node --experimental-strip-types --test tests/deviceApi.test.mjs",
    "test:workflow": "node --experimental-strip-types --test tests/robotWorkflowApi.test.mjs",
    "test:transcript": "node --experimental-strip-types --test tests/transcriptApi.test.mjs",
    "test:conversation": "node --experimental-strip-types --test tests/conversationApi.test.mjs",
    "test:help": "node --experimental-strip-types --test tests/helpRequest.test.mjs",
    "test:web": "playwright test",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo-google-fonts/source-sans-3": "^0.4.2",
    "@expo/metro-runtime": "~6.1.2",
    "@fugood/react-native-audio-pcm-stream": "^1.1.4",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/slider": "5.0.1",
    "ajv": "^8.17.1",
    "crypto-js": "^4.2.0",
    "expo": "~54.0.0",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-linear-gradient": "~15.0.8",
    "expo-video": "~3.0.16",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "whisper.rn": "^0.7.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@playwright/test": "^1.58.2",
    "@types/crypto-js": "^4.2.2",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.0",
    "typescript": "~5.9.0"
  }
}
